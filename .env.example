# O Concord e P2P: nao ha banco de dados central, autenticacao por servidor
# nem TURN para configurar. Isto so importa para quem roda a ponte web
# opcional (apps/server) - veja docs/DEPLOY_WEB.md.
#
# O cliente Electron (o app de verdade) nao le nenhuma destas variaveis.

# ---- apps/server (ponte WebSocket para acesso via navegador) ----
PORT=3001
# Onde o SQLite e a identidade da instancia web ficam salvos.
DATA_DIR=./data

# Atras de proxy (Railway, Render): use o IP real de X-Forwarded-For.
# TRUST_PROXY=1
# Origens extras aceitas no WebSocket, separadas por virgula.
# ALLOWED_ORIGINS=https://meu-front.exemplo.com
# Limites contra abuso (padroes em docs/DEPLOY_WEB.md).
# MAX_SESSIONS=50
# MAX_SESSIONS_PER_IP=3
