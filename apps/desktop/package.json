{
  "name": "@concord/desktop",
  "version": "0.7.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run typecheck && node scripts/bundle.js && node scripts/copy-renderer.js",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "stage": "node scripts/stage.js",
    "predist": "npm run stage",
    "dist": "electron-builder --config electron-builder.yml --win nsis zip --publish never",
    "prerelease": "npm run stage",
    "release": "electron-builder --config electron-builder.yml --win nsis zip --publish always",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@concord/core": "0.1.0",
    "@concord/types": "0.1.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^20.16.5",
    "app-builder-bin": "^5.0.0-alpha.10",
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "build": {
    "extends": null
  },
  "description": "Concord - comunicacao P2P para gamers",
  "author": "Concord"
}
