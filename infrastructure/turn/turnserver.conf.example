# coturn configuration for Concord (development)
# Copy to turnserver.conf and replace the credentials before starting the stack.
#
#   cp infrastructure/turn/turnserver.conf.example infrastructure/turn/turnserver.conf
#
# turnserver.conf is gitignored on purpose - it holds the shared secret.

listening-port=3478
tls-listening-port=5349

# Relay range exposed to peers. Keep it narrow in dev; widen in production.
min-port=49160
max-port=49200

fingerprint

# Long-term credential mechanism. For production prefer `use-auth-secret`
# with time-limited credentials generated by the API (see docs/WEBRTC.md).
lt-cred-mech
user=concord:CHANGE_ME
realm=concord.local

# In production set this to the public IP of the TURN host.
# external-ip=203.0.113.10

no-cli
no-tlsv1
no-tlsv1_1
log-file=stdout
verbose
